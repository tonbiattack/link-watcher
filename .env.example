# link-watcher の設定例
# 使い方: このファイルを .env にコピーして値を埋め、ご自身の方法で環境変数に読み込んでください。
# このリポジトリは .env を自動で読み込みません（環境変数を直接読むだけです）。

# --- 監視対象（必須） ---
WATCH_URL=https://example.com/news
WATCH_SELECTOR=h2 a

# 除外したい URL の正規表現（改行区切り）
# WATCH_IGNORE=/tag/
# WATCH_IGNORE=/privacy/

# --- 状態ファイル ---
WATCH_STATE_PATH=.linkwatch/state.json
WATCH_TIMEOUT=30

# --- LINE Messaging API ---
LINE_CHANNEL_ACCESS_TOKEN=
# 未設定なら友だち全員に broadcast されます
# ユーザーIDは U、グループIDは C、ルームIDは R で始まります
LINE_TO=

# --- 挙動の切り替え ---
# 1 にすると送信も保存もせず、結果だけログに出します
WATCH_DRY_RUN=
# 1 にすると初回実行でも既存リンクを通知します
WATCH_NO_SEED=
