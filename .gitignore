# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Test and lint caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Watcher state produced by local runs.
# The state file itself is tracked so scheduled runs can persist it; anything else is not.
.linkwatch/*
!.linkwatch/state.json
log.log

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
